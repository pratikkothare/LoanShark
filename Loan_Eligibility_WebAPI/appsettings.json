{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "LoanEligibilityDBConnectionString": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=LoanEligibilityDB;Integrated Security=True;"
  },
  "AzureBlobStorage": {
    "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT_NAME;AccountKey=YOUR_ACCOUNT_KEY;EndpointSuffix=core.windows.net",
    "ContainerName": "loandocuments"
  },
  "AzureOpenAI": {
    "Endpoint": "https://loaniq-chatbot.cognitiveservices.azure.com/",
    "Key": "YOUR_AZURE_OPENAI_KEY_HERE",
    "Deployment": "lonIq-chatbot"
  }
}